.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 33, 80, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}
.dialog {
  width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}
.title { font-size: 30rpx; font-weight: 600; color: #20386f; }
.mood-row { display: flex; gap: 20rpx; margin: 24rpx 0; }
.mood { width: 84rpx; height: 84rpx; border-radius: 42rpx; background: #f0f4ff; display: flex; align-items: center; justify-content: center; }
.mood.active { background: #dbe8ff; border: 1px solid #5d87ff; }
.textarea { width: 100%; height: 160rpx; border-radius: 16rpx; background: #f7f9ff; padding: 20rpx; box-sizing: border-box; }
.btn-row { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; }
.btn { background: #2d8cff; color: #fff; border-radius: 999rpx; font-size: 26rpx; padding: 0 28rpx; }
.btn.ghost { background: #eff4ff; color: #3e5ea8; }
